}

// add pebbles for Nation Brand
function checkPebble() {
  var bodyStyles = window.getComputedStyle(document.body);
  var getTheme = bodyStyles.getPropertyValue("--theme");
  if (getTheme == "NB" && $(".material-symbols.pebble").length > 0) {
    $(".material-symbols.pebble").each(function () {
      replacePebble(this);
    });
  }
}
function replacePebble(iconpebble) {
  var rndNbr = Math.floor(Math.random() * 6) + 1;
  const url =
    typeof $(iconpebble).data("aem-pebble") === "undefined"
      ? "/includes/resources/svg"
      : "/etc.clientlibs/austrade-commons/clientlibs/clientlib-site/resources/images";
  $(iconpebble).css("background-color", "unset");
  $(iconpebble).css("background-image", `url(${url}/nb-pebble-${rndNbr}.svg)`);
}

$(document).ready(function ($) {
  // check if emergency bar needs to be visible
  if ($("#emergency-bar").length != 0) {
    var emergencyNotice = sessionStorage["emergency-notice"];
    if (!emergencyNotice) {
      $("#emergency-bar").show();
    }
    $("#emergency-bar-close").click(function () {
      sessionStorage["emergency-notice"] = "True";
      $("#emergency-bar").fadeOut();
    });
  }

  // add nested start increment to OL tag
  $('ol[start]').each(function() {
    var val = parseFloat($(this).attr("start")) - 1;
    $(this).css('counter-increment','list '+ val);
  });

  // open mobile search
  if ($("#global-nav-mobile form")) {
    $("#global-nav-mobile form").hide();
  }
  $("#mobile-search-icon").on("click", function () {
    $("#mobile-search-icon").hide();
    $("#global-nav-mobile form").show();
    $("#mobile-search-form").focus();
  });
  $("#mobile-search-close-icon").on("click", function () {
    $("#global-nav-mobile form").hide();
    $("#mobile-search-icon").show();
  });

  // Add date to footer
  const year = new Date().getFullYear();
  $("#footer-year")?.append(year);

  //Background image
  const mobileWidth = "540";
  function parseBackgroundImageUrlBasedOnViewport(srcset, containerWidth) {
    let max = 0;
    let min = 0;
    let imageUrl = srcset
        ?.split(",")
        ?.reduce((accumulator, current) => {
          const currentWidth = parseInt(current.split(" ")[1].slice(0, -1));
          const accumulatorWidth =
              accumulator === 0
                  ? accumulator
                  : parseInt(accumulator?.split(" ")[1]?.slice(0, -1));
          const currentMax = max
              ? parseInt(max?.split(" ")[1]?.slice(0, -1))
              : max;
          const currentMin = min
              ? parseInt(min?.split(" ")[1]?.slice(0, -1))
              : min;
          if (currentWidth >= currentMax) max = current;
          if (!currentMin || currentWidth < currentMin) min = current;
          if (
              currentWidth > containerWidth &&
              (!accumulatorWidth || currentWidth < accumulatorWidth)
          ) {
            accumulator = current;
          }
          return accumulator;
        }, 0);
    if (!imageUrl) {
      parseInt(min?.split(" ")[1]?.slice(0, -1)) > containerWidth
          ? (imageUrl = min)
          : (imageUrl = max);
    }
    return imageUrl?.split(" ")[0];
  }
  function setupBackgroundImage() {
    $(".bg-image").each(function () {
      const image = $(this).find("img.image-bg");
      if (!image.length > 0) return;
      const containerWidth = parseInt(
          window.getComputedStyle(this).getPropertyValue("width").slice(0, -2)
      );
      let imageUrl = "";
      let mobileImageUrl = $(image[0]).data("mobile-src")
      let mobileImageSrcSet = $(image[0]).data("mobile-srcset")
      if (containerWidth <= mobileWidth && (mobileImageUrl || mobileImageSrcSet)) {
        imageUrl = mobileImageUrl;
        if (mobileImageSrcSet) {
          imageUrl = parseBackgroundImageUrlBasedOnViewport(mobileImageSrcSet, containerWidth);
        }
      } else {
        imageUrl = image[0].src;
        if (image[0].srcset) {
          imageUrl = parseBackgroundImageUrlBasedOnViewport(image[0].srcset, containerWidth);
        }
      }

      $(this).css("background-image", `url(${imageUrl})`);
      $(image).css("display", "none");
    });
  }
  setupBackgroundImage();
  $(window).on('resize' , setupBackgroundImage);

  // Back to top
  var mybutton = document.getElementById("btn-back-to-top");
  if (mybutton) {
    $(window).scroll(function () {
      if (
        document.body.scrollTop > 1000 ||
        document.documentElement.scrollTop > 1000
      ) {
        mybutton.style.display = "block";
      } else {
        mybutton.style.display = "none";
      }
    });
    mybutton.addEventListener("click", function () {
      document.body.scrollTop = 0;
      document.documentElement.scrollTop = 0;
    });
  }

  // Open responsive tables
  const checkTable = document.querySelectorAll("table:not(.table-responsive > table, pre > table)");
  if (checkTable) {
    $("table:not(.table-responsive > table, pre > table) tr :first-child").on("click", function () {
      var parent = $(this).parent().get(0);
      $(parent).children("td,th").toggleClass("showGroup");
      $(parent).toggleClass("groupParent");
    });
    checkTable.forEach(function (table) {
      const rows = Array.from(table.querySelectorAll("tr"));
      const headingTitles = Array.from(rows[0].querySelectorAll("th,td")).map(
        function (heading) {
          return heading.innerText;
        }
      );
      rows.forEach(function (row, rowIndex) {
        if (!rowIndex) return;
        Array.from(row.querySelectorAll("th,td")).forEach(function (
          cell,
          cellIndex
        ) {
          cell.dataset.title = headingTitles[cellIndex];
        });
      });
    });
  }

  // Background video
  var vidContainers = document.querySelectorAll(".bg-video-player");
  vidContainers.forEach(function (vidcont) {
    var videofile = vidcont.querySelector(".video-file");
    var playButton = vidcont.querySelector(".PlayPauseBtn");
    var fullscreenButton = vidcont.querySelector(".PlayFullscreenBtn");
    function togglePlay() {
      if (videofile.paused || videofile.ended) {
        videofile.play();
      } else {
        videofile.pause();
      }
    }
    function updatePlayBtn() {
      playButton.innerHTML = videofile.paused
        ? '<span class="material-symbols">play_circle</span>'
        : '<span class="material-symbols">pause_circle</span>';
    }
    function playFullscreen() {
      if (videofile.requestFullscreen) {
        videofile.requestFullscreen();
      } else if (videofile.webkitRequestFullscreen) {
        /* Safari */
        videofile.webkitRequestFullscreen();
      } else if (videofile.msRequestFullscreen) {
        /* IE11 */
        videofile.msRequestFullscreen();
      }
    }
    fullscreenButton.addEventListener("click", playFullscreen);
    playButton.addEventListener("click", togglePlay);
    videofile.addEventListener("click", togglePlay);
    videofile.addEventListener("play", updatePlayBtn);
    videofile.addEventListener("pause", updatePlayBtn);
  });

  // Share with social media
  const socialfield = document.querySelector(".copy-field");
  if (socialfield) {
    const socialinput = socialfield.querySelector("input");
    const socialcopy = socialfield.querySelector("button");
    socialinput.value = window.location.href;
    socialcopy.onclick = () => {
      socialinput.select();
      if (document.execCommand("copy")) {
        socialfield.classList.add("active");
        socialcopy.innerText = "Copied";
        setTimeout(() => {
          window.getSelection().removeAllRanges();
          socialfield.classList.remove("active");
          socialcopy.innerText = "Copy";
        }, 3000);
      }
    };
    const facebook = document.querySelector(".social-facebook");
    const linkedin = document.querySelector(".social-linkedin");
    const reddit = document.querySelector(".social-reddit");
    const twitter = document.querySelector(".social-twitter");
    const whatsapp = document.querySelector(".social-whatsapp");

    facebook
      ? (facebook.href =
          "http://www.facebook.com/share.php?u=" +
          encodeURI(window.location.href))
      : "";
    linkedin
      ? (linkedin.href =
          "https://www.linkedin.com/sharing/share-offsite/?url=" +
          encodeURI(window.location.href))
      : "";
    reddit
      ? (reddit.href =
          "http://www.reddit.com/submit?url=" +
          encodeURI(window.location.href) +
          "&title=" +
          document.title)
      : "";
    twitter
      ? (twitter.href =
          "https://twitter.com/intent/tweet?ref_src=twsrc%5Etfw&original_referer=" +
          encodeURI(window.location.href))
      : "";
    whatsapp
      ? (whatsapp.href =
          "whatsapp://send?text=" + encodeURI(window.location.href))
      : "";
  }
  function powerBiContainerResize() {
    const iframes = Array.from(document.querySelectorAll(".cmp-embed iframe"));
    if (!iframes.length) return;
    iframes.forEach(function (iframe) {
      const iframeDesktopHeight = iframe.dataset.heightDesktop;
      const iframeMobileHeight = iframe.dataset.heightMobile;

      const screenSize = window.innerWidth;
      const mobileBreakpoint = 768;

      if (screenSize <= mobileBreakpoint) {
        iframe.style.height = `${iframeMobileHeight}px`;
      } else {
        iframe.style.height = `${iframeDesktopHeight}px`;
      }
    });
  }

  // Power BI resize

  function debounce(func, delay) {
    let timerId;

    return function (...args) {
      clearTimeout(timerId);

      timerId = setTimeout(() => {
        func.apply(this, args);
      }, delay);
    };
  }

  const delayInMillisecond = 200;
  const debouncedResizeHandler = debounce(
    powerBiContainerResize,
    delayInMillisecond
  );

  window.addEventListener("resize", debouncedResizeHandler);
  powerBiContainerResize();
  checkPebble();
});

$(document).ready(function() {
  const imgList = document.querySelectorAll('.three-fourths-container-image .cmp-image img');
  imgList.forEach((img) => {
    img.removeAttribute('width');
    img.removeAttribute('height');
  });
});
$(function ($) {
  if (!$) {
    $ = jQuery;
  }

  //Facet filter
  $("body").on("change", ".search-facets input[type=radio]", function () {
    document
      .querySelectorAll(".search-facets input[type=radio]")
      .forEach((el) => (el.checked = false));
    this.checked = true;

    var currentElement = this;
    // Find the closest ancestor form element
    while (currentElement && currentElement.nodeName !== "FORM") {
      currentElement = currentElement.parentNode;
    }

    if (currentElement) {
      currentElement.submit();
    }
  });

  $(".search-hero .form-control button").click(() => {
    const firstInput = document.querySelector(
      ".search-badges input:first-of-type"
    );
    document
      .querySelectorAll(".search-facets input[type=radio]")
      .forEach((el) => (el.checked = false));
    firstInput.checked = true;
  });

 // submit search on filter change - news index page
  $("#dropdownMenuButton").on("change", function () {
    $("#news-search").closest("form").submit()
  });

  //toggle collapse facets
  $(".search-facet-toggle").click(function (event) {
    event.preventDefault();
    $(this).blur();
    $(".search-facets").toggleClass("open");
    $(".search-facets--content").toggle("fast");
  });

  //Enabling all filter when filter is not available in query.
  const UrlParams = new URLSearchParams(window.location.search);
  let filterParam = UrlParams.get("filter");
  if (!filterParam) {
    const firstInput = document.querySelector(
      ".search-badges input:first-of-type"
    );
    if (firstInput) {
      firstInput.checked = true;
      firstInput.disabled = true;
    }
  }
});

$(function ($) {
  $("body").on(
    "change",
    ".search-pagination input[type=checkbox]",
    function () {
      $(this).closest("form").submit();
    }
  );

  const mobileBreakpoint = 767;
  const first = $(".pagination-display:first-child");
  const last = $(".pagination-display:last-child");
  const current = $(".pagination-active--true");
  const tabsOnDesktop = 3;

  function displayPagination() {
    const screenSize = window.innerWidth;

    if (screenSize <= mobileBreakpoint) {
      recursivePagination(current.next(), "next");
      recursivePagination(current.prev(), "prev");
    } else {
      recursivePagination(current.next(), "next", tabsOnDesktop);
      recursivePagination(current.prev(), "prev", tabsOnDesktop);
    }

    const ellipsis = "<span class='pagination-ellipsis'>...</span>";
    const nextElement = 1;
    const prevElement = 1;

    if (
      Number(first.text()) + nextElement !==
      Number(first.next(".pagination-display, .pagination-active--true").text())
    ) {
      $(ellipsis).insertAfter(first);
    }

    if (
      Number(last.text()) - prevElement !==
      Number(last.prev(".pagination-display, .pagination-active--true").text())
    ) {
      $(ellipsis).insertBefore(last);
    }
  }

  const defaultPagesForDisplay = 1;

  function recursivePagination(currentElement, direction, pagesForDisplay = defaultPagesForDisplay) {
    if (!pagesForDisplay || !currentElement) return;
    currentElement.addClass("pagination-display");
    pagesForDisplay--;
    if (direction === "next")
      recursivePagination(currentElement.next(), "next", pagesForDisplay);
    if (direction === "prev")
      recursivePagination(currentElement.prev(), "prev", pagesForDisplay);
  }
  function handleResize() {
    $(".pagination-display:not(:first-child):not(:last-child)").each(
      function () {
        $(this).removeClass("pagination-display");
      }
    );
    $(".pagination-ellipsis").each(function () {
      $(this).remove();
    });
    displayPagination();
  }
  function debounce(func, delay) {
    let timerId;

    return function (...args) {
      clearTimeout(timerId);

      timerId = setTimeout(() => {
        func.apply(this, args);
      }, delay);
    };
  }
  const delayInMilliseconds = 200;
  const debouncedResizeHandler = debounce(handleResize, delayInMilliseconds);
  window.addEventListener("resize", debouncedResizeHandler);
  displayPagination();
});

// Sticking w jQuery since it is easy for everyone to understand!
$(function () {

    var $j = jQuery.noConflict();

    function show($el, flag) {
        if (flag) {
            $el.show();
        } else {
            $el.hide();
        }
    }

    function toggleClearSearch(inputValue) {
        const elements = document.querySelectorAll('.clear-search');
        for (let i = 0; i < elements.length; i++) {
            if (inputValue.length > 0) {
                elements[i].style.display = 'block';
            } else {
                elements[i].style.display = 'none';
            }
        }
    }

    $j('.clear-search').click(() => {
        const input = document.getElementById('global-search-form');
        input.value = '';
        toggleClearSearch('');

        const elements = document.querySelectorAll('.quick-suggestions');
        for (let i = 0; i < elements.length; i++) {
            elements[i].style.display = 'none';
        }

        // mobile search
        const mobElements = document.querySelectorAll('.offcanvas .search-field input.form-control');
        for (let i = 0; i < elements.length; i++) {
            mobElements[i].value = '';
        }
    })

    $j('.clear-search').on('keyup', function (evt) {
       if(evt.keyCode === 13 ) {
                   const input = document.getElementById('global-search-form');
                   input.value = '';
                   toggleClearSearch('');

                   const elements = document.querySelectorAll('.quick-suggestions');
                   for (let i = 0; i < elements.length; i++) {
                       elements[i].style.display = 'none';
                   }
             }
        })

    $j('body').on('keyup', '.search form[data-quick-suggestions] input[name=q], .header form[data-quick-suggestions] input[name=q]', function (evt) {
        var $form = $j(this).closest('form'),
            $input = $form.find('input').val(),
            $lists = $form.find('[data-quick-lists]'),
            $list = $form.find('[data-quick-suggestions]');

        show($list, $input.length >= 3);
        show($lists, $input.length >= 3);
        toggleClearSearch($input);

        if ($form.data('quick-suggestions-enabled') === true && $input.length >= 3 && !keys.includes(evt.key)) {
            const url = $form.data('quick-suggestions') + '?q=' + $input;
            fetch(url).then(response => response.json()).then(data => {
                $list.find('li').remove();
                $list.find('p').remove();
                if (data && data.suggestions) {
                    $j.each(data.suggestions, function (index, suggestion) {
                        if (index === data.suggestions.length - 1) {
                            $list.append($j(`<li id="opt-${index + 1}" role="option" class="last search_item">`).text(suggestion));
                        } else {
                            $list.append($j(`<li class="search_item" id="opt-${index + 1}" role="option" tabindex="-1">`).text(suggestion));
                        }
                    });
                    $list.prepend($j('<p class="suggested">').text('Suggested search items...'));
    
                    show($list, data.suggestions.length > 0);
                    show($lists, $lists.find('li').length > 0);
                    currItem = '';
                }
            });
        }
    });

    $j('body').on('keyup', '.search form[data-quick-search-results] input[name=q]', function () {
        var $form = $j(this).closest('form'),
            $lists = $form.find('[data-quick-lists]'),
            $list = $form.find('[data-quick-results]');

        if ($form.data('quick-search-results-enabled') === true) {
            $j.get($form.data('quick-search-results'), $form.serialize(), function (data) {
                $list.find('li').remove();

                $j.each(data.results, function (index, result) {
                    $list.append($j('<li>').append($j('<a>').attr('href', result.url).text(result.title)));
                });

                show($list, data.results.length > 0);
                show($lists, $lists.find('li').length > 0);
            });
        }
    });

    $j('.search-field').on('click', '.quick-lists .quick-suggestions li', function () {
        var $form = $j(this).closest('form'),
            $searchField = $form.find('input[name=q]'),
            autoComplete = $j(this).text();

        $searchField.val(autoComplete);
        $form.submit();
    });

    $j('.search-spellcheck span').click(function () {
        var $form = $j(this).closest('form'),
            $searchField = $form.find('input[name=q]'),
            autoComplete = $j(this).text();
        $searchField.val(autoComplete);
        $form.submit();
    });
});

//added this js to make search field keyboard accessible

   let currItem;
   const keys = ['ArrowUp', 'ArrowDown', 'Enter'];
   const searchInput = document.querySelector('.search_input');
    let itemsArr = Array.from(document.querySelectorAll('#searchtypes'));


    const setSelected = (item) => {
          const searchInput = document.querySelector('.form-control');
          const listbox = document.querySelector('#searchtypes');
          listbox.querySelectorAll('.search_item').forEach(listItem => {
            if (listItem === item) {
              item.setAttribute('aria-selected', 'true');
              searchInput.setAttribute('aria-activedescendant', item.id);
              currItem = item;
              item.scrollIntoView({ block: "nearest", inline: "nearest" });
            } else {
              listItem.removeAttribute('aria-selected');
            }
          })
                    if (!item.className.includes("search_item")) {
                      currItem = '';
                    }
    }





            searchInput.addEventListener('keydown', (evt) => {
            if (keys.includes(evt.key) && itemsArr.length > 1) {
                    evt.preventDefault();
                     if (!currItem && evt.key === 'ArrowDown') {
                       setSelected(document.querySelector('#opt-1'));
                     } else if (currItem && evt.key === 'ArrowDown' && currItem.nextElementSibling) {
                       setSelected(currItem.nextElementSibling);
                     }

                    if (currItem && evt.key === 'ArrowUp' && currItem.previousElementSibling) {
                      setSelected(currItem.previousElementSibling);
                    }

                    if (evt.key === 'Enter') {
                    let itemsArrSelected = Array.from(document.querySelectorAll('.search_item'));
                      itemsArrSelected.forEach(item => {
                        if (searchInput.value.toLowerCase() === item.textContent.toLowerCase() || item.hasAttribute('aria-selected')) {
                          item.click();
                        }
                      })

                       const element = document.querySelector(".search-field");
                       const form = element.closest("form");
                       form.submit();
                    }
            }
            })
function shortenURL(url){
  const { href } = window.location;
  return href.includes("adobeaemcloud.com") || href.includes("localhost") ? url : `/${url.slice(1).split("/").slice(2).join("/")}`
}

function formatLink(link) {
  let formatted = link[link.length - 1] === "/" ? link.slice(0, -1) : link;
  return `${formatted}`;
}

function formatTime(duration) {
  const millisecondsToSecond = 1000;
  const secondsToMinutes = 60;
  const minutesToHour = 60;
  const hoursToDay = 24;
  const AMToPm = 12;
  const prependCheck = 10;
  const midnightCheck = 0;
  let minutes = Math.floor((duration / (millisecondsToSecond * secondsToMinutes)) % minutesToHour);
  let hours = Math.floor((duration / (millisecondsToSecond * secondsToMinutes * minutesToHour)) % hoursToDay);
  let session = hours >= AMToPm ? "PM" : "AM";

  if (hours === midnightCheck) {
    hours = AMToPm;
  } else if (hours > AMToPm) {
    hours = hours - AMToPm;
    session = "PM";
  }

  minutes = minutes < prependCheck ? "0" + minutes : minutes;

  return  `${hours}:${minutes} ${session}`;
}

function formatDate(date) {
  const formattedDate = new Date(date);
  return {
    day: formattedDate.getDate(),
    month: formattedDate.toLocaleString("default", {
      month: "long",
    }),
    year: formattedDate.getFullYear(),
  };
}

function capitaliseString(string) {
  return string.charAt(0).toUpperCase() + string.slice(1);
}

function capitalizeEachWord(str) {
    const excludeWords = ["the", "and", "of"];

    if (str == null || (typeof str === "string" && str.trim().length === 0)) {
      return "";
    } else {
        const words = str.split(" ");
        for (let i = 0; i < words.length; i++) {
            if(excludeWords.includes(words[i].toLowerCase())) {
                words[i] = words[i].toLowerCase()
            } else {
                words[i] = words[i][0].toUpperCase() + words[i].substr(1);
            }
            if(words[0] === 'the') {
              words[0] = 'The'
            }
        }
        return words.join(" ");
    }
}

function calculateSrcset(element,srcset){
  const containerWidth = parseInt(window.getComputedStyle(element).getPropertyValue("width").slice(0, -2));
  let imageUrl;
  let max = 0;
  let min = 0;
  imageUrl = srcset.split(",")?.reduce((accumulator, current) => {
      const currentWidth = parseInt(current.split(" ")[1].slice(0, -1));
      const accumulatorWidth = accumulator === 0 ? accumulator : parseInt(accumulator?.split(" ")[1]?.slice(0, -1));
      const currentMax = max ? parseInt(max?.split(" ")[1]?.slice(0, -1)) : max;
      const currentMin = min ? parseInt(min?.split(" ")[1]?.slice(0, -1)) : min;
      if (currentWidth >= currentMax) max = current;
      if (!currentMin || currentWidth < currentMin) min = current;
      if (currentWidth > containerWidth && (!accumulatorWidth || currentWidth < accumulatorWidth)) {
          accumulator = current;
      }
      return accumulator;
  }, 0);
  if (!imageUrl) {
      parseInt(min?.split(" ")[1]?.slice(0, -1)) > containerWidth ? (imageUrl = min) : (imageUrl = max);
  }
  return imageUrl?.split(" ")[0];
}

$(document).ready(function($){
    $(".list-random").each(function(index , element){
        let attr = $(element).data("remote-data");
        $(element).load(attr)
    })
});
