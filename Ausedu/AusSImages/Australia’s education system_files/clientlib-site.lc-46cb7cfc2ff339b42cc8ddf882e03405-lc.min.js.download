// change font for language translations
var chkLang = document.documentElement.lang.toLowerCase();
if(!(chkLang.match("^en"))) {
  var defLang = "";
  if (chkLang == "ar" || chkLang == "ko" || chkLang == "th" || chkLang == "zh" || chkLang == "ja" ) {
    defLang = "-" + chkLang;
  }
  // var appLang = '<link rel="stylesheet" href="/includes/css/noto-sans' + defLang + '.css" type="text/css" />';
  var appLang = '<link rel="stylesheet" href="/content/dam/austrade-assets/appdata/css/noto-sans' + defLang + '.css" type="text/css" />';
